# Copy to .env.local for local development. Never commit real secrets.
# Use separate values for development, preview/staging, and production.

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# PostgreSQL / Neon / Prisma
# DATABASE_URL: Neon pooled connection string (used for app runtime queries)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.neon.tech:5432/DATABASE?sslmode=require
# DIRECT_URL: Neon direct connection string (used for Prisma migrations)
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.neon.tech:5432/DATABASE?sslmode=require

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (only if configured)
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me

# Google Gemini - server only; never prefix with NEXT_PUBLIC_
GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-3.5-flash-lite

# Resend transactional email
RESEND_API_KEY=replace-me
EMAIL_FROM=replace-after-domain-verification
EMAIL_REPLY_TO=replace-with-monitored-address

# Background jobs (exact variables depend on verified provider integration)
INNGEST_EVENT_KEY=replace-me
INNGEST_SIGNING_KEY=replace-me

# Bot protection (if enabled)
TURNSTILE_SECRET_KEY=replace-me
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-me

# Optional monitoring; configure only after privacy review
# SENTRY_DSN=replace-me
